# Copy to /entropy/.env, then fill values locally.
# Never commit .env or paste private key into chat.

# Safety defaults
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# AI decision engine (OpenAI-compatible endpoint; fallback to heuristic if empty)
AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=

# Hyperliquid API wallet / agent wallet
# Signer only. Do not use master wallet private key.
HL_API_WALLET_PRIVATE_KEY=0xYOUR_API_WALLET_PRIVATE_KEY
HL_API_WALLET_ADDRESS=0xYOUR_API_WALLET_ADDRESS

# Master wallet or subaccount address.
# Used for account state queries; do not set to API wallet address.
HL_ACCOUNT_ADDRESS=0xYOUR_MASTER_OR_SUBACCOUNT_ADDRESS

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Live mode requires all of these explicitly:
# DRY_RUN=false
# LIVE_TRADING_ENABLED=true
